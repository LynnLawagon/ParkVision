# Copy to backend/.env and fill in the three Supabase values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Server only: use sb_secret_... or legacy service_role, NOT the publishable key.
# Never use a VITE_ prefix for this value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Defaults work with the Python environment already created on this Mac.
# ML_PYTHON=/Users/YOUR_NAME/.venvs/parkvision-ml/bin/python
# MODEL_PATH=/absolute/path/to/parkvision_efficientnetb0.keras
MINIMUM_CONFIDENCE=0.80
# Optional CCTV: copy cctv.example.json to cctv.local.json; keep stream logins server-only.
# Deferred feature. Leave disabled for the image/video/device-camera prototype.
ENABLE_CCTV=false
# CCTV_CONFIG_PATH=/absolute/path/to/cctv.local.json
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
